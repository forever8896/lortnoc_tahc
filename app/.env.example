# Copy to .env.local. Only needed for ?live; mock mode needs none of this.
#
# NOTE: the ENS addresses are NOT here — they live in src/lib/live/ens-deployment.json and are
# written there by `node scripts/ens/deploy.mjs`. Nothing to copy by hand.

# Optional: a Sepolia RPC with a higher rate limit than the public default
VITE_SEPOLIA_RPC=

# Optional: the address the inbox-delegation demo grants to.
# Defaults to 0x…dEaD — the permission checks are simulations, so it never needs funds.
# Set it to a second wallet you control if you want the gateway to execute a real write.
VITE_GATEWAY_ADDR=

# Sui (testnet) — the published Move package id (conversation module)
VITE_SUI_PACKAGE=
# Optional: Seal key servers (comma-separated) when wiring Seal
VITE_SEAL_SERVERS=
