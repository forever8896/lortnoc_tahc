# Copy to .env.local and fill in after the day-0 setup (docs/LIVE-SETUP.md).
# Only needed for ?live; mock mode needs none of this.

# ENS v2 (Sepolia) — the resolver serving *.lortnoc.eth handles
VITE_LORTNOC_RESOLVER=
VITE_LORTNOC_REGISTRY=
# optional: the gateway address the inbox-delegation demo grants to (defaults to your addr)
VITE_GATEWAY_ADDR=

# Sui (testnet) — the published Move package id (conversation module)
VITE_SUI_PACKAGE=
# optional: Seal key servers (comma-separated) when wiring Seal
VITE_SEAL_SERVERS=
