codec/finetune/casual.jsonl
codec/finetune/*.bin
codec/finetune/lora-adapter/
codec/finetune/cover-model/

# build artifacts
*.tsbuildinfo

# ENS day-0 scripts
scripts/**/node_modules/
scripts/ens/.deploy-state.json
contracts/out/
contracts/cache/

# Build artifacts
app/contracts/move/build/
lortnoc-tahc-extension-v1/
.claude/worktrees/

# Paired-test browser profiles (contain a logged-in Telegram session)
extension/.dev-profiles/

# Built extension artifacts. Releases are built by CI from a tag and published on GitHub with a
# SHA-256 + provenance attestation (.github/workflows/release.yml) — that is the ONLY artifact
# anyone should trust. Unpacked trees and zips sitting in the working tree are indistinguishable
# candidates of unclear provenance, which undercuts exactly the claim the release workflow makes.
lortnoc-tahc-extension-*/
lortnoc-tahc-extension-*.zip
lortnoc-tahc-extension-*.zip.sha256

# Browser binaries for the Playwright test tier (npx playwright install chromium).
/node_modules/

# Internal working documents. Kept on disk, out of the public repo: they are
# planning and status material, and some of it names where operational secrets
# live. The public technical story is README.md + docs/ARCHITECTURE.md.
/CLAUDE.md
/CHECKLIST.md
/PLAN.md
/.env.example
/docs/LAUNCH-PLAN.md
/docs/PRD-*.md
/docs/landing-prompt.md
/docs/x-threads*.md
/docs/check-threads.mjs
